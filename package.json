{
  "name": "uxgraphy-portfolio",
  "version": "1.0.0",
  "description": "Somnath Nabajja portfolio — static site (Tailwind CSS, plain HTML/JS).",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch",
    "serve": "browser-sync start --server --no-open --files \"**/*.html, assets/css/*.css, assets/js/*.js\" --port 3000",
    "dev": "npm-run-all --parallel watch:css serve"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  }
}
